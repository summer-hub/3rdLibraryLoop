{
    "name": "@ohos-cpf/3rdloop_core",
    "version": "0.0.11",
    "description": "3rdLibraryLoop 核心包：Server 引擎 + 插件内核（core/）+ 插件（plugins/）+ 能力契约（seams/）+ profile（profiles/）+ 配套资产（MCP/Archive/BadCase）",
    "type": "module",
    "private": false,
    "license": "MIT",
    "author": "LalHan <hanle12@huawei.com>",
    "homepage": "https://gitcode.com/summor/3rdLibraryLoop",
    "repository": {
        "type": "git",
        "url": "git+https://gitcode.com/summor/3rdLibraryLoop.git"
    },
    "bugs": {
        "url": "https://gitcode.com/summor/3rdLibraryLoop/issues"
    },
    "keywords": [
        "3rdlibrary",
        "harmonyos",
        "opencode",
        "engine",
        "plugin-kernel",
        "code-review"
    ],
    "engines": {
        "node": ">=22"
    },
    "files": [
        "Server",
        "plugins",
        "core",
        "seams",
        "profiles",
        "MCP",
        "Archive",
        "BadCase",
        "Web/public",
        "Web/ext",
        "README.md",
        "!**/.env",
        "!**/.env.*",
        "!**/*.signing",
        "!**/node_modules"
    ],
    "scripts": {
        "test": "node test/run-all.mjs",
        "test:m1": "node test/m1/run-all.mjs",
        "test:m2": "node test/m2/run-all.mjs",
        "test:m3": "node test/m3/run-all.mjs",
        "test:m4": "node test/m4/run-all.mjs",
        "test:m5": "node test/m5-phase2/run-all.mjs",
        "test:m6": "node test/m6-phase3/run-all.mjs",
        "test:m7": "node test/m7-phase4/run-all.mjs",
        "test:m8": "node test/m8-plugin-kernel/run-all.mjs",
        "test:m9": "node test/m9-contract-conformance/run-all.mjs",
        "test:m10": "node test/m10-host-scope/run-all.mjs",
        "test:m11": "node test/m11-storage-list-semantics/run-all.mjs",
        "test:m12": "node test/m12-cli-lifecycle/run-all.mjs",
        "test:m13": "node test/m13-update-from-release/run-all.mjs",
        "test:m14": "node test/m14-web-ext-source/run-all.mjs",
        "test:unit": "node Server/Agent/SkillSelector/__tests__/test-pure-logic.js",
        "lint": "biome lint",
        "lint:fix": "biome lint --write",
        "coverage": "node scripts/coverage.mjs",
        "release:pack": "node scripts/release.mjs",
        "ci": "node scripts/ci.mjs",
        "verify": "npm run lint && npm run test"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0",
        "@opencode-ai/sdk": "^1.18.6",
        "better-sqlite3": "^13.0.1",
        "chokidar": "^4.0.0",
        "dotenv": "^17.0.0",
        "jieba-wasm": "^2.4.0",
        "openai": "^4.104.0",
        "typescript": "^5.5.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.13"
    }
}
