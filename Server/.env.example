# ─── LLM 配置（百炼 / DashScope OpenAI 兼容模式）───────────────────────────
# 百炼平台 API Key，从 https://bailian.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=your_api_key_here

# 百炼 OpenAI 兼容端点（不要随意修改）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 调用的模型名；经百炼调用智谱 GLM-5.1
LLM_MODEL=glm-5-1

# LLM 采样参数（可选）
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
# 是否开启 GLM 思考模式（enable_thinking）。
#   false（默认，推荐）= 关闭思考，响应快；这两个 ReAct 步骤（任务拆解/排序）是简单分类任务，不需要深度思考
#   true              = 开启思考，质量更高但慢（单步可达 10-40s）
LLM_ENABLE_THINKING=false

# 模糊匹配召回的候选数量（可选，默认 5）
SELECTOR_TOP_K=5

# 命中阈值（LLM 打分 0-100，top1 >= 该值且 top1-top2 分差>=10 才算检索命中）
# 默认 60；低于此值或分差过小判定为未命中，best/skillPath 返回 null
# 配合规则化评分：语言不匹配/动作类型不一致等硬伤会被压到 45-50 以下
SELECTOR_HIT_THRESHOLD=60

# 备用模型（连续 3 次 529 过载时切换，留空则不切换）
FALLBACK_MODEL=qwen3.7-max

# 多路召回融合权重（动作通道 / 领域通道 / 原文兜底通道，三者之和无需为 1，内部会按比例融合）
# 默认 0.4 / 0.4 / 0.2。领域通道用于匹配 SKILL 的 useWhen 与产出物特征词，是提升召回稳定性的关键。
SELECTOR_WEIGHT_ACTION=0.4
SELECTOR_WEIGHT_DOMAIN=0.4
SELECTOR_WEIGHT_RAW=0.2

# ─── 编排并发控制 ──────────────────────────────────────────────────────────
# 全局 AI Session 并发上限（Orchestrator 进程级信号量，跨所有编排任务共享）。
# 并行 fan-out 步骤 / 多任务同时提交时，活跃 opencode Session 总数不超过该值，
# 超出部分 FIFO 排队。前端顶栏"🔀 并发"pill 实时展示占用（15s 轮询）。
MAX_CONCURRENT_SESSIONS=50

# GitCode Token（用于访问私有仓库，若不需要可留空）
GIT_TOKEN=xxxxxxxxxxxxxxxxxx
