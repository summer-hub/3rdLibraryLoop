# Dependencies
node_modules/

# Lock files
# 注意：package-lock.json 必须入库（F-05）。
# 本项目用 npm 安装（README / start-services.mjs 均走 npm install），
# 锁定版本才能保证「同一 commit → 同一依赖树」的可复现构建；
# 此前把 lockfile 一并忽略，导致 clone 后依赖漂移、无法复现问题。
# 仅在确实使用其他包管理器时才忽略其 lockfile。
yarn.lock
pnpm-lock.yaml

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.seed
*.pid.lock

# Environment variables
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
.cursor/
*.swp
*.swo

# Build output
dist/
build/
*.tsbuildinfo

# Database files
*.sqlite
*.db-journal

*.signing

# 类型契约（本地保留，不提交远端）
Server/Agent/SkillSelector/types.js

# CLI 发布产物（仅 npm pack/publish 时临时生成，不入库）
cli/vendor/

# AOCI agent host integration (machine-bound; do not commit)
.mcp.json
.mcp.json.backup.*

# 本地既有资产（个人工作文件，不入库；此前一直以未跟踪状态出现在 git status 里）
.aoci/
aoci.txt
aoci.code.txt
aoci.meta.txt
.stepcode/
AGENTS.md.backup.*
*.emmx
docs/DB-SCHEMA-REFERENCE.md
