{
  "downstreamServers": {
    "kb-server": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.huaness.tech/mcp",
      "headers": {
        "Authorization": "Bearer test-secret"
      }
    }
  },
  "scriptsDir": "./scripts",
  "scripts": {
    "enabled": true,
    "hotReload": true,
    "timeout": 120000,
    "allowedExtensions": [".sh", ".py", ".js", ".cjs"]
  },
  "knowledgeBase": {
    "enabled": true,
    "enginePath": "../Archive/src/index.js",
    "dataDir": "../Archive/data"
  },
  "gateway": {
    "name": "mcp-gateway",
    "version": "1.0.0",
    "transport": "stdio"
  }
}
