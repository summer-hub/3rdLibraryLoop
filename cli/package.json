{
    "name": "@3lib/loop-cli",
    "version": "0.1.0",
    "description": "3rdLibraryLoop 三方库自动化检视 CLI：嵌入式复用核心引擎，任务生命周期管理（submit/run/wait/progress/abort/list/result/doctor）",
    "type": "module",
    "license": "UNLICENSED",
    "bin": {
        "loop": "bin/loop.mjs"
    },
    "main": "lib/cli.js",
    "engines": {
        "node": ">=22"
    },
    "files": [
        "bin",
        "lib",
        "vendor",
        "README.md"
    ],
    "scripts": {
        "prepack": "node scripts/prepack.mjs",
        "postpack": "node scripts/clean-vendor.mjs",
        "verify-deps": "node scripts/verify-deps.mjs",
        "test": "node --test test/*.mjs"
    },
    "dependencies": {
        "@github/copilot-sdk": "^1.0.8",
        "@opencode-ai/sdk": "^1.18.6",
        "better-sqlite3": "^13.0.1",
        "dotenv": "^17.0.0",
        "openai": "^4.0.0"
    }
}